# ============================================================
# XG2010G（2010.config）专用插件开关
# 由 .github/workflows/build-2010.yml 在 make defconfig 之前追加到 .config。
# 放在 custom/ 里，同步 naoki66 / ImmortalWrt 上游时不会被覆盖。
#
# 本文件只影响 XG2010G 构建；XR1710G 用的是 custom/config.fragment。
# ============================================================

# ---------- ① IPTV：只用 msd_lite ----------
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
# 另外两个组播转单播（udpxy / rtp2httpd）与 msd_lite 功能重叠，关掉
# CONFIG_PACKAGE_udpxy is not set
# CONFIG_PACKAGE_luci-app-udpxy is not set
# CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn is not set
# CONFIG_PACKAGE_rtp2httpd is not set
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set
# CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn is not set

# ---------- ② DDNS：只用 ddns-go ----------
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
# 传统 ddns-scripts 一套不再需要
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts-aliyun is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set
# CONFIG_PACKAGE_ddns-scripts-dnspod-v3 is not set

# ---------- ③ 代理：装 daed + 中文界面 ----------
# daed = dae 的守护版（自带 Web UI）。注意：它会连带编译 BPF 工具链（llvm-bpf），
# 构建时间会明显变长，这是 dae 系列固有的代价。
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y

# ---------- ④ 删掉其它代理软件的残留 ----------
# homeproxy / sing-box（用户明确不需要）
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn is not set
# CONFIG_PACKAGE_homeproxy is not set
# CONFIG_PACKAGE_sing-box is not set
# pbr 策略路由（不是代理，但属于同类分流工具，一并关掉；需要可在下面改回 =y）
# CONFIG_PACKAGE_luci-app-pbr is not set
# CONFIG_PACKAGE_luci-i18n-pbr-zh-cn is not set
# CONFIG_PACKAGE_pbr is not set
# PassWall 本体从未选入，只剩子选项残留
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set

# ---------- ⑤ 主题：换成 glass ----------
CONFIG_PACKAGE_luci-theme-glass=y
# argon 那套换掉
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# （默认主题由 custom/files-2010/etc/uci-defaults/99-theme-glass.sh 设为 glass）

# ---------- ⑥ 语音：保留"运营商语音通话"，去掉"电话主机/PBX"功能 ----------
# 保留（插电话线能正常打电话所必需）：
CONFIG_PACKAGE_airoha-voice-ctl=y
CONFIG_PACKAGE_asterisk=y
CONFIG_PACKAGE_asterisk-pjsip=y
CONFIG_PACKAGE_asterisk-chan-en75xx=y
CONFIG_PACKAGE_asterisk-codec-ulaw=y
CONFIG_PACKAGE_asterisk-codec-alaw=y
CONFIG_PACKAGE_asterisk-codec-g722=y
CONFIG_PACKAGE_asterisk-format-sln=y
CONFIG_PACKAGE_asterisk-format-wav=y
CONFIG_PACKAGE_asterisk-res-rtp-asterisk=y
CONFIG_PACKAGE_asterisk-app-playtones=y
# 去掉（本地电话主机/小总机才用得上的功能）：
# CONFIG_PACKAGE_asterisk-app-record is not set
# CONFIG_PACKAGE_asterisk-app-stack is not set
# CONFIG_PACKAGE_asterisk-bridge-softmix is not set
# CONFIG_PACKAGE_asterisk-res-musiconhold is not set
# CONFIG_PACKAGE_asterisk-pbx-spool is not set
# CONFIG_PACKAGE_asterisk-sounds is not set
# CONFIG_PACKAGE_asterisk-codec-a-mu is not set
# CONFIG_PACKAGE_asterisk-codec-gsm is not set
# CONFIG_PACKAGE_asterisk-format-gsm is not set
# CONFIG_PACKAGE_asterisk-format-pcm is not set
# 如果发现电话打不通/没声音，把上面某几条改成 =y 再编一次即可（最可能是 codec/format 那几条）。