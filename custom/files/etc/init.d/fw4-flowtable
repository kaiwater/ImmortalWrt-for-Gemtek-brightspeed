#!/bin/sh /etc/rc.common
# Keep the MLO interface in the hardware-offload flowtable: nft silently drops
# a netdev from a flowtable when it unregisters and never adds it back, and
# ap-mld0 shows up long after fw4's first load.  The actual polling lives in
# /usr/sbin/fw4-mlo-offload, run as a procd service so it survives the init
# script exit.
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/fw4-mlo-offload
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
