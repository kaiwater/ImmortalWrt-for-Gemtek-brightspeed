#!/bin/sh
#
# XG2010G：覆盖 autocore 的 /sbin/tempinfo
#
# 用途：LuCI 概览页「系统」板块的「温度」一行。rpcd 的 luci.getTempInfo 就是
#       popen 这个脚本，把它 stdout 原样填进那一格。
#
# autocore 原版只输出 CPU 一路（"CPU: 60.6°C"）。这里改成列出全部可读温度源，
# 让概览页一眼就能看到 CPU、两个万兆 PHY 和 PON 光模块。
#
# 采集全部交给 /usr/libexec/xg2010g-temps（单个 awk 进程，约 3 次 fork / 0.01 s）。
# 概览页每 5 秒轮询一次都会走这里，所以这条路径的开销必须压到最低 ——
# 早期版本用 shell 循环逐项拼装，单次 130 次 fork / 0.22 s，把页面拖卡了。
#
# 说明：本文件由 custom/files-2010/ 提供。rootfs 组装阶段（include/image.mk 的
#       prepare_rootfs）是在所有包安装完之后才覆盖 files/ 的，所以能盖掉
#       autocore 装进去的同名文件。

HELPER=/usr/libexec/xg2010g-temps

if [ ! -x "$HELPER" ]; then
	printf '无温度信息'
	exit 0
fi

# 命令替换会去掉末尾换行，与原版 tempinfo 的 echo -n 行为保持一致
printf '%s' "$("$HELPER")"
