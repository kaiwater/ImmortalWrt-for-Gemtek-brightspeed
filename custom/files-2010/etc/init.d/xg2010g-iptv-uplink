#!/bin/sh /etc/rc.common
#
# XG2010G：维护 IPTV 上行（网桥 MAC + DHCP 租约 + 专网路由）
#
# 背景见 /etc/xg2010g-iptv-uplink.sh 的注释：运营商对 IPTV 专网做 (MAC, IP)
# 源地址校验，所以网桥 MAC 必须等于光猫 MAC、地址必须用 DHCP 租约、且租约
# 1800 秒到期前必须续约 —— 这三件事都需要在运行时反复做，脚本常驻循环。
#
# START=21：必须排在 iptv（19，它负责建 br-iptv）和 network（20）之后，
# 否则脚本跑的时候网桥还不存在。
#
# 用 procd 托管：这是常驻进程，意外退出（OOM、被误杀）后巡检就静默消失了，
# respawn 会把它拉起来。respawn 3600 5 10 = 稳定运行满 1 小时重置短命退出计数；
# 退出后 5 秒重试；连续 10 次短命退出后放弃（避免死循环）。

START=21
STOP=10
USE_PROCD=1

start_service() {
	[ -x /etc/xg2010g-iptv-uplink.sh ] || return 0

	procd_open_instance
	procd_set_param command /etc/xg2010g-iptv-uplink.sh
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
