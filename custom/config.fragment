# ============================================================
# XR1710G (ImmortalWrt) 自定义插件开关
# 由 .github/workflows/build-firmware.yml 在 make defconfig 之前追加到 .config。
# 单独放在 custom/ 目录，是为了同步 naoki66 / ImmortalWrt 上游时不会被覆盖。
#
# 修改插件：直接增删下面的配置行，然后运行一次 Build XR1710G Firmware。
# ============================================================

# ---------- 编译进固件的插件 ----------
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# ---------- 透明代理：homeproxy / Nikki / daed 三个全部编入（2026-10-04 新增） ----------
#
# ⚠️⚠️ 体积风险（务必先读）⚠️⚠️
# XR1710G 的设备定义里**没有 IMAGE_SIZE**，所以构建时不会有 check-size 拦截，
# 超限不会报错——但也不代表刷进去能启动。历史构建产物最大只到 77.30 MiB。
# 本次新增的三个代理 .apk 合计约 66 MiB，按实测 squashfs 压缩比 0.80 折算
# 约 +53 MiB → 镜像预计到 120+ MiB，**这个体积从未在真机上验证过**。
# 若刷入后 U-Boot 无法加载 FIT，设备会起不来，只能靠串口/TFTP 恢复。
# 保守做法：把下面三组的 =y 改成 =m（只编译不编入），从 artifact 里取 .apk
# 装进 overlay（实测 385 MiB 可用）。
#
# ⚠️ 本机将有 3 个代理工具（homeproxy / Nikki / daed），它们会同时争抢
# DNS 接管 / TPROXY / nftables 规则 / 路由表。**同一时间只应启用一个。**
# （OpenClash 已于 2026-10-06 移除，理由见下面「不需要的插件」一节。）

# homeproxy（sing-box 内核）
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y

# Nikki（mihomo 内核）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y
# Nikki 依赖 yq，显式打开，避免被解析成 m 而不进镜像
CONFIG_PACKAGE_yq=y

# daed（kenzok8/openwrt-daede，eBPF 内核）
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daede_daed=y
# 如需 dae 命令行后端（可在界面里热切换），把下面一行改 =y
# CONFIG_PACKAGE_luci-app-daede_dae is not set
CONFIG_PACKAGE_daed=y
# immortalwrt 侧的旧界面不装
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-i18n-daed-zh-cn is not set
# daed-geoip / daed-geosite 是 immortalwrt 侧的聚合包；kenzok8 的 daed
# 已直接依赖 v2ray-geoip / v2ray-geosite
# CONFIG_PACKAGE_daed-geoip is not set
# CONFIG_PACKAGE_daed-geosite is not set

# ---------- 不需要的插件（保持关闭） ----------

# OpenClash（2026-10-06 移除）
# 与 Nikki 完全重复 —— 两者用的都是 mihomo 内核，只是界面不同；同时装会争抢
# DNS 接管 / TPROXY / nftables 规则 / 路由表。Nikki 已覆盖全部功能，只保留 Nikki。
# 上游 1710.config 本来就是 not set，这里显式写出是为了防止上游日后改动。
# 移除后配套删掉：custom/feeds.conf.custom 里的 openclash feed、
# build-firmware.yml 里的 Bundle latest OpenClash core 步骤、
# 以及 custom/scripts/fetch-openclash-core.sh。
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-i18n-openclash-zh-cn is not set

# Ruby 全家桶（2026-10-06 移除，约 4.9 MiB）
#
# 依据：把 6 个 feed（immortalwrt/packages + luci + openwrt/routing + telephony +
# kenzok8/openwrt-daede + nikkinikki-org/OpenWrt-nikki）全部拉下来做 DEPENDS 反查，
# **整个仓库里唯一依赖 `ruby` 的包就是 `luci-app-openclash`**（它在 vernesong/OpenClash
# 和 immortalwrt/luci 两个 feed 里各有一份）。OpenClash 已在上一条移除，Ruby 就没有
# 任何依赖方了；在设备上也搜不到除 OpenClash 之外的任何 ruby 调用方。
#
# 上游 1710.config 里 openclash 本来就是 not set 却留着这套 Ruby，说明它就是为
# OpenClash 准备的（用户从 overlay 装 OpenClash 时不用再下 Ruby）。
#
# 实测安装体积：libruby 3838 KiB、ruby-bigdecimal 541、ruby-date 147、ruby-psych 132、
# ruby-digest 74、ruby-enc 48、ruby-pstore 26、ruby-stringio 33、ruby-yaml 12、
# ruby 4 KiB（元包）、lyaml 53、libyaml 104。
#
# lyaml / libyaml 的唯一依赖者 `luci-app-passwall` 不在 1710 清单里
# （libyaml 的其它依赖者 python-yaml / ser2net / stubby / fluent-bit 也都不在）。
#
# ⚠️ 注意：**如果以后要往这台设备装 OpenClash，必须先把这套 Ruby 装回来**，
# 否则 OpenClash 起不来。Nikki 用 mihomo 内核（Go），不需要 Ruby。
# CONFIG_PACKAGE_ruby is not set
# CONFIG_PACKAGE_libruby is not set
# CONFIG_PACKAGE_ruby-bigdecimal is not set
# CONFIG_PACKAGE_ruby-date is not set
# CONFIG_PACKAGE_ruby-digest is not set
# CONFIG_PACKAGE_ruby-enc is not set
# CONFIG_PACKAGE_ruby-pstore is not set
# CONFIG_PACKAGE_ruby-psych is not set
# CONFIG_PACKAGE_ruby-stringio is not set
# CONFIG_PACKAGE_ruby-yaml is not set
# CONFIG_PACKAGE_lyaml is not set
# CONFIG_PACKAGE_libyaml is not set

# dae / daed 的内核与工具链支持（2026-10-04：三个代理都启用后必须打开）
# 依据：immortalwrt/packages 的 net/daed/Makefile 明确写着
#   # You need enable KERNEL_DEBUG_INFO_BTF and KERNEL_BPF_EVENTS
# 而 1710.config 里 CONFIG_KERNEL_DEBUG_INFO_REDUCED=y 会挡住 BTF
# （Kconfig: KERNEL_DEBUG_INFO_BTF depends on !KERNEL_DEBUG_INFO_REDUCED），
# 所以下面几行都要处理。
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y

# TC-eBPF 内核模块（daed 的 DEPENDS 会自动带，这里显式写出便于核对）
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# BPF 工具链：改用宿主机 LLVM，省去从源码编译 LLVM 的 30~60 分钟。
# 前提：build-firmware.yml 的 Setup build environment 必须装 llvm，并给
# llc / opt / llvm-dis / llvm-strip 建未加版本号的软链（include/bpf.mk 找这些名字）。
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
# CONFIG_BPF_TOOLCHAIN_NONE is not set
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
CONFIG_USE_LLVM_HOST=y

# 以下 BPF 用户态工具保持关闭
# CONFIG_PACKAGE_tc-bpf is not set
# CONFIG_PACKAGE_bpfcountd is not set
# CONFIG_PACKAGE_bpftool-full is not set
# CONFIG_PACKAGE_bpftool-minimal is not set
# udpxy
# CONFIG_PACKAGE_udpxy is not set
# CONFIG_PACKAGE_luci-app-udpxy is not set
# CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn is not set
# msd_lite
# CONFIG_PACKAGE_msd_lite is not set
# CONFIG_PACKAGE_luci-app-msd_lite is not set
# CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn is not set
# vlmcsd
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set
# wechatpush
# CONFIG_PACKAGE_luci-app-wechatpush is not set
# CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn is not set
# CONFIG_PACKAGE_WECHATPUSH_Enable_Host_Information_Detection is not set
# wifihistory
# CONFIG_PACKAGE_luci-app-wifihistory is not set
# CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn is not set
# timewol
# CONFIG_PACKAGE_luci-app-timewol is not set
# CONFIG_PACKAGE_luci-i18n-timewol-zh-cn is not set
# 传统 DDNS（已改用 ddns-go）
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set
# CONFIG_PACKAGE_ddns-scripts-aliyun is not set
# CONFIG_PACKAGE_ddns-scripts-dnspod is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set
# smartdns
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_smartdns-ui is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set
# UPNP
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# WiFi 定时开关
# CONFIG_PACKAGE_wifischedule is not set
# CONFIG_PACKAGE_luci-app-wifischedule is not set
