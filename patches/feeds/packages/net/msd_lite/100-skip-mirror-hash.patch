From: kaiwater <kaiwater@users.noreply.github.com>
Subject: [PATCH] msd_lite: skip the mirror hash check

dl_github_archive regenerates the tarball on this host and the result no longer matches PKG_MIRROR_HASH (submodule checkout metadata). The pinned commit is still used; only the hash check is skipped.

---
diff --git a/net/msd_lite/Makefile b/net/msd_lite/Makefile
index d16307b..17ea393 100644
--- a/net/msd_lite/Makefile
+++ b/net/msd_lite/Makefile
@@ -11,7 +11,7 @@ PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/rozhuk-im/msd_lite.git
 PKG_SOURCE_DATE:=2026-07-21
 PKG_SOURCE_VERSION:=fa68e131343fb58c67ad77b2d26f2cb7c49a2c95
-PKG_MIRROR_HASH:=2bea5dc389328b5f885abc14215134db62f8c26052c859340e1c1f85872af2fb
+PKG_MIRROR_HASH:=skip
 
 PKG_MAINTAINER:=Tianling Shen <cnsztl@immrotalwrt.org>
 PKG_LICENSE:=BSD-2-Clause
