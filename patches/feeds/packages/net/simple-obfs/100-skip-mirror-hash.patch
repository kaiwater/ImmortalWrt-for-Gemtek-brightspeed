From: kaiwater <kaiwater@users.noreply.github.com>
Subject: [PATCH] simple-obfs: skip the mirror hash check

Same as msd_lite: regenerated git archive (submodule libcork) does not match PKG_MIRROR_HASH. Keep the pinned commit, skip the hash.

---
diff --git a/net/simple-obfs/Makefile b/net/simple-obfs/Makefile
index decfefc..85155af 100644
--- a/net/simple-obfs/Makefile
+++ b/net/simple-obfs/Makefile
@@ -18,7 +18,7 @@ PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/shadowsocks/simple-obfs.git
 PKG_SOURCE_DATE:=2019-08-17
 PKG_SOURCE_VERSION:=486bebd9208539058e57e23a12f23103016e09b4
-PKG_MIRROR_HASH:=bc97eba511b86a089ab4bcf0ac78d9e4a39c59046d5cde77b79a118245daa0ba
+PKG_MIRROR_HASH:=skip
 
 PKG_LICENSE:=GPL-3.0-or-later
 PKG_LICENSE_FILES:=LICENSE
