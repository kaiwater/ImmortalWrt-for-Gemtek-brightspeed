 ifeq ($(CONFIG_NODEJS_HOST_BIN),y)
 
-NODEJS_BIN:=node-v$(PKG_VERSION)-linux-x64.tar.gz
+# The prebuilt tarball has to match the build host, not the target: an aarch64
+# build host (native arm64 Linux or a Lima VM on Apple Silicon) needs the
+# linux-arm64 build, everything else keeps the linux-x64 one.
+NODEJS_BIN_HOST_ARCH:=$(if $(findstring aarch64,$(shell uname -m)),arm64,x64)
+NODEJS_BIN:=node-v$(PKG_VERSION)-linux-$(NODEJS_BIN_HOST_ARCH).tar.gz
